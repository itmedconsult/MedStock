# Google Apps Script web-app deployment URL ending in /exec
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Must match the MEDSTOCK_WEB_API_TOKEN Script Property in Apps Script.
GOOGLE_SHEETS_API_TOKEN=replace-with-a-long-random-token

# Brother b-PAC browser module and local P-touch template
NEXT_PUBLIC_BPAC_MODULE_URL=/brother/bpac.js
NEXT_PUBLIC_BROTHER_TEMPLATE_PATH=C:\MedStock\labels\medstock.lbx
